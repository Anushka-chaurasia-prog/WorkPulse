# ===================================================================
# WorkPulse Docker Environment Configuration Example
# Copy this file to .env and configure local secret values
# ===================================================================

# Database Configuration (MySQL & Backend)
DB_NAME=employee_management
DB_USERNAME=employee_app
DB_PASSWORD=your_secure_db_password
DB_ROOT_PASSWORD=your_secure_root_password
DB_PORT=3306

# Backend Application Configuration
BACKEND_PORT=8080
JWT_SECRET=your_base64_encoded_256bit_jwt_secret_key_here
JWT_EXPIRATION=3600000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# Frontend Configuration (Browser-accessible URL)
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080
